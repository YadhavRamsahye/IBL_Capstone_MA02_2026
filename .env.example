# Copy to .env and fill in. .env is gitignored; never commit real values.

# ── Summary provider ──────────────────────────────────────────────────────────
# Which backend generates the traffic summaries.
#   template  - no API, no cost; uses the built-in fallback text
#   gemini    - Google Gemini (free tier)
#   anthropic - Claude
SUMMARY_PROVIDER=template

# Google Gemini - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier quota is per model. gemini-2.0-flash returns limit:0 on a
# current free key; verify with tools/check_gemini.py before changing.
# Gemma works here too (same endpoint, no code change) - e.g.
# gemma-4-31b-it. Comparable output on this prompt but ~3-4x slower.
# Free-tier Gemini allows 20 requests/day. Calls are spent only on
# heavy/bottleneck cameras. 0 = unlimited (paid plans).
SUMMARY_DAILY_BUDGET=20

GEMINI_MODEL=gemini-3-flash-preview

# Claude
ANTHROPIC_API_KEY=sk-ant-...

# Hard kill switch - set to 1 to force template summaries regardless of the
# provider above.
CLAUDE_API_DISABLED=

# ── Session security ──────────────────────────────────────────────────────────
# Signs session cookies. Was previously a literal committed to source, which
# let anyone with the repository forge an admin session.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set true when serving over HTTPS so cookies are not sent over plain HTTP.
SESSION_HTTPS_ONLY=false

# Built-in admin fallback, used only when no database was reachable at
# startup. Opt-in - defaults off. Set to true only for a deliberate demo
# where the database genuinely may not be set up.
ALLOW_DEMO_LOGIN=false
DEMO_PASSWORD=admin123

# ── Cameras ───────────────────────────────────────────────────────────────────
# MYT publishes 38 cameras island-wide (detection/camera_catalogue.py, generated
# by tools/fetch_cameras.py). All 38 appear on the map; this controls which ones
# detection actually runs on.
#
# Each active camera costs an ffmpeg subprocess plus a YOLOv8m inference every
# 2 seconds. On CPU-only inference more than a handful saturates the machine and
# frame grabs start timing out - you get worse data from many cameras than from
# a few. Raise this gradually and watch fps_processed.
#
#   (unset)  the four validated Port Louis cameras
#   all      every catalogued camera - realistically needs a GPU
#   a,b,c    explicit ids
ACTIVE_CAMERAS=

# ── Database ──────────────────────────────────────────────────────────────────
# No default password any more - persistence stays off until this is set.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=trafficsystem

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated. The "null" origin was previously allowed, which let any
# local file:// page call the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# -- Email (password recovery) -------------------------------------------------
# Leave SMTP_HOST blank to run without a mail server: messages are written to
# sent_emails/ and the reset link is printed to the log, so the flow still works
# end to end for development and demos.
#
# Gmail: enable 2-step verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and use that as SMTP_PASSWORD.
# Your normal account password will be rejected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=IBL Traffic Detection
SMTP_TLS=starttls

# Base address used to build links inside emails. Must be reachable by whoever
# receives the mail - localhost only works on this machine.
PUBLIC_BASE_URL=http://localhost:8000

# How long a reset link stays valid, and how many may be requested per account
# per hour (so the form cannot be used to flood an inbox).
RESET_TOKEN_TTL_MINUTES=30
RESET_MAX_PER_HOUR=5
