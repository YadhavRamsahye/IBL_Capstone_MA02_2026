# Copy to .env and fill in. .env is gitignored; never commit real values.

# ── Claude API ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Session security ──────────────────────────────────────────────────────────
# Signs session cookies. Was previously a literal committed to source, which
# let anyone with the repository forge an admin session.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set true when serving over HTTPS so cookies are not sent over plain HTTP.
SESSION_HTTPS_ONLY=false

# Built-in admin fallback, used only when no database is reachable. Set to
# false for anything internet-facing.
ALLOW_DEMO_LOGIN=true
DEMO_PASSWORD=admin123

# ── Database ──────────────────────────────────────────────────────────────────
# No default password any more — persistence stays off until this is set.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=trafficsystem

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated. The "null" origin was previously allowed, which let any
# local file:// page call the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
