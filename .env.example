# IBL Capstone — Traffic Bottleneck Detection System
# Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Anthropic Claude API key (required for AI-generated traffic summaries).
# Obtain from: https://console.anthropic.com/settings/keys
# If not set, the system falls back to template-based summaries automatically.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
